# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable is optional except the API key when the Gemini provider is used.

# --- Model --------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
LEXICLEAR_GOOGLE_API_KEY=

# "gemini" for real analysis, "mock" to run the whole product offline with a
# deterministic stand-in (used by the test suite and the end-to-end run).
LEXICLEAR_LLM_PROVIDER=gemini
LEXICLEAR_GENERATION_MODEL=gemini-3.6-flash
LEXICLEAR_EMBEDDING_MODEL=gemini-embedding-001
# Comma-separated models tried in order if the main one is overloaded.
LEXICLEAR_FALLBACK_MODELS=

# --- Application --------------------------------------------------------------
LEXICLEAR_ENVIRONMENT=development
LEXICLEAR_CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Privacy and limits -------------------------------------------------------
# Documents live in memory only, for this many seconds.
LEXICLEAR_DOCUMENT_TTL_SECONDS=1800
LEXICLEAR_MAX_UPLOAD_BYTES=10485760
# Replace direct identifiers with placeholders before any text is sent upstream.
LEXICLEAR_REDACT_PII_BEFORE_LLM=true

# --- Rate limits (per client address) -----------------------------------------
LEXICLEAR_RATE_LIMIT_UPLOADS=10/minute
LEXICLEAR_RATE_LIMIT_ANALYSIS=20/minute
LEXICLEAR_RATE_LIMIT_QUESTIONS=40/minute
